# --- Backend API ---
# Point this at your Django backend base URL, including the API prefix.
# Local dev example: http://localhost:8000/api
# Production example: https://your-backend-domain.com/api
VITE_API_BASE_URL=http://localhost:8000/api

# --- Firebase (needed for real login + Google sign-in) ---
# Get these from Firebase Console > Project Settings > General > Your apps > SDK setup.
# Leave them blank to keep running in local demo mode (localStorage auth,
# no Google button) while you wait on Firebase project access.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
